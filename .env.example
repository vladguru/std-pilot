# Образец файла настроек. Все значения фиктивные.
# Настоящие значения хранятся только в настройках облачной среды, в секретах GitHub и хостингов.
# Для локального запуска файл копируется в .env; файл .env в репозиторий не добавляется.
# Настройки читаются только из переменных окружения (правило переносимости, ARCHITECTURE.md).

# Порт, на котором сервис принимает соединения.
PORT=8080
API_PORT=8080
# Порт веб-интерфейса.
WEB_PORT=3000
# База данных PostgreSQL для разработки и тестов (docker compose и PostgreSQL облачной среды используют эти значения).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
